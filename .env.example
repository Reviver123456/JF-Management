# Required — Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server-only — same screen, service_role key (never expose to the browser)
SUPABASE_SECRET_KEY=your-server-only-secret-or-service-role-key

# Optional — Playwright E2E (npm run test:e2e)
# E2E_TEST_EMAIL=your-test-user@example.com
# E2E_TEST_PASSWORD=your-test-password
# E2E_EXPECT_SEED=1

# Optional — fixed recipient for report email delivery (defaults to service@jfadvancemed.com)
# NEXT_PUBLIC_REPORT_EMAIL_RECIPIENT=service@jfadvancemed.com

# Optional local legacy aliases
# NEXT_PUBLIC_SUPABASE_ANON_KEY=same-as-publishable-key
